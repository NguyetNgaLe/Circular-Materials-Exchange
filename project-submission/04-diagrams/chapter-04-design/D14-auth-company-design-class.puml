@startuml
allowmixing
title D14 - Design Class: Auth và Company microservice as-built
skinparam classAttributeIconSize 0

package "API Gateway - REST/gRPC adapter" {
  class JWTAuthMiddleware <<Middleware>> {
    -authClient: AuthServiceClient
    +JWTAuth()
    +AdminOnly()
  }

  class AuthHTTPHandler <<Controller>> {
    -authClient: AuthServiceClient
    -companyClient: CompanyServiceClient
    +Register(ctx)
    +Login(ctx)
    +GetMe(ctx)
  }

  class CompanyHTTPHandler <<Controller>> {
    -client: CompanyServiceClient
    +CreateCompany(ctx)
    +GetCompany(ctx)
    +ListCompanies(ctx)
    +ApproveCompany(ctx)
    +RejectCompany(ctx)
  }
}

package "Auth Service" {
  class AuthGRPCHandler <<Controller>>
  class AuthService <<Service>>
  class UserRepository <<Repository>>
  class User <<Entity>>
  AuthGRPCHandler --> AuthService
  AuthService --> UserRepository
  UserRepository --> User
}

package "Company Service" {
  class CompanyGRPCHandler <<Controller>>
  class CompanyService <<Service>>
  class CompanyRepository <<Repository>>
  class Company <<Entity>>
  CompanyGRPCHandler --> CompanyService
  CompanyService --> CompanyRepository
  CompanyRepository --> Company
}

database "auth_db" as AuthDB
database "company_db" as CompanyDB

JWTAuthMiddleware --> AuthGRPCHandler : VerifyToken/GetUserByEmail
AuthHTTPHandler --> AuthGRPCHandler : Login/Register/GetUser
AuthHTTPHandler --> CompanyGRPCHandler : GetCompanyByOwner
CompanyHTTPHandler --> CompanyGRPCHandler : Company RPC
UserRepository --> AuthDB : SQL
CompanyRepository --> CompanyDB : SQL
User ..> Company : logical CompanyID / OwnerID

note bottom
  Gateway không giữ sql.DB.
  Auth và Company tự sở hữu repository/database.
end note
@enduml
