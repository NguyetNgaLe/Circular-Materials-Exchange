@startuml
title D18 - Sequence upload ảnh và đăng nguồn cung (as-built)
autonumber

actor Seller
participant "React SPA" as Web
participant "API Gateway" as Gateway
participant "Bearer-token Middleware" as Auth
participant "Company Service" as Company
participant "Material Service" as Material
participant "MinIO / cme-images" as MinIO <<Object Storage>>
database "company_db" as CompanyDB
database "material_db" as MaterialDB

Seller -> Web : Chọn ảnh vật liệu
Web -> Gateway : POST /api/upload (multipart + token)
Gateway -> Auth : Xác thực
Auth --> Gateway : seller_id
Gateway -> Gateway : Kiểm tra <= 5 MB và đuôi file
Gateway -> Material : UploadImage(bytes, metadata)\n(gRPC)
Material -> MinIO : HTTP PUT /cme-images/listings/...
MinIO --> Material : 200
Material --> Gateway : image_url
Gateway --> Web : image_url

Seller -> Web : Nhập thông tin và gửi
Web -> Gateway : POST /api/listings + image_url
Gateway -> Auth : Xác thực
Auth --> Gateway : seller_id
Gateway -> Company : GetCompanyByOwner(gRPC)
Company -> CompanyDB : SELECT theo owner_id
CompanyDB --> Company : Company(verified)
Company --> Gateway : Company(verified)
Gateway -> Material : CreateListing(gRPC)
Material -> MaterialDB : INSERT supply_listings(status=active)
MaterialDB --> Material : listing_id
Material --> Gateway : success + id
Gateway --> Web : HTTP 200
Web --> Seller : Hiển thị đăng thành công

alt Company chưa verified
  Gateway --> Web : HTTP 403
  Gateway --> Web : Yêu cầu hoàn tất hồ sơ
end

note over Gateway,MaterialDB
  Gateway không truy cập SQL hoặc MinIO trực tiếp.
  image_url/images đã có trong bootstrap và migration.
end note
@enduml
