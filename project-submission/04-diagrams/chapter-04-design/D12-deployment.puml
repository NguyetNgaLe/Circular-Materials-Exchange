@startuml
title D12 - Deployment Diagram microservice as-built
skinparam componentStyle rectangle

node "Thiết bị người dùng" as client {
  artifact "Web Browser" as browser
}

node "Frontend Server" as frontendHost {
  component "Nginx\nHTTP :13005" as nginx
  artifact "React SPA build\n/tmp/stitch-app" as web
  nginx --> web : static + SPA fallback
}

node "Backend Docker Server" as backendHost {
  cloud "Docker network: cme-network" as network {
    component "cme-api-gateway\nGo + Gin\nHTTP :8085" as gateway
    component "auth-service\n:50051" as auth
    component "company-service\n:50052" as company
    component "material-service\n:50053" as material
    component "order-service\n:50054" as order
    component "review-service\n:50055" as review
    component "notification-service\n:50056" as notification
    database "cme-postgres\nPostgreSQL 15\nHost :5433\n6 logical databases" as postgres
    queue "cme-nats\n:4222 / :8222" as nats
    storage "cme-minio\n:9000 / :9001" as minio
  }

  folder "Persistent volumes" {
    artifact "pg-data" as pgdata
    artifact "minio-data" as miniodata
  }
}

browser --> nginx : HTTP
nginx --> gateway : reverse proxy /api/

gateway --> auth : gRPC
gateway --> company : gRPC
gateway --> material : gRPC
gateway --> order : gRPC
gateway --> review : gRPC
gateway --> notification : gRPC

auth --> postgres : auth_db
company --> postgres : company_db
material --> postgres : material_db
order --> postgres : order_db
review --> postgres : review_db
notification --> postgres : notif_db
material --> minio : HTTP PUT ảnh
order --> nats : publish cme.orders.*
nats --> notification : event subscription
postgres --> pgdata
minio --> miniodata

note right of gateway
  Gateway publish 8085:8085 và tham gia cme-network.
  Không có driver PostgreSQL hoặc SQL trong Gateway.
end note
@enduml
