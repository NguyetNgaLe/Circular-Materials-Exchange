@startuml
allowmixing
title D15 - Design Class: Material và Upload microservice as-built
skinparam classAttributeIconSize 0

package "API Gateway - REST/gRPC adapter" {
  class MaterialHTTPHandler <<Controller>> {
    -materialClient: MaterialServiceClient
    -companyClient: CompanyServiceClient
    +ListCategories(ctx)
    +ListListings(ctx)
    +GetListing(ctx)
    +CreateListing(ctx)
    +UpdateListing(ctx)
    +DeleteListing(ctx)
    +ListDemands(ctx)
    +CreateDemand(ctx)
  }

  class UploadHandler <<Controller>> {
    -materialClient: MaterialServiceClient
    +UploadImage(ctx)
  }
}

package "Material Service" {
  class MaterialGRPCHandler <<Controller>> {
    -service: MaterialService
    -minioURL: string
    +UploadImage(ctx)
  }
  class MaterialService <<Service>>
  class MaterialRepository <<Repository>>
  class Category <<Entity>>
  class SupplyListing <<Entity>>
  class DemandListing <<Entity>>

  MaterialGRPCHandler --> MaterialService
  MaterialService --> MaterialRepository
  MaterialRepository --> Category
  MaterialRepository --> SupplyListing
  MaterialRepository --> DemandListing
  Category "1" -- "0..*" SupplyListing
  Category "1" -- "0..*" DemandListing
}

database "material_db" as MaterialDB
class CompanyGRPCHandler <<External gRPC>>
storage "MinIO\ncme-images" as MinIO

MaterialHTTPHandler --> MaterialGRPCHandler : Material RPC
MaterialHTTPHandler --> CompanyGRPCHandler : verify Company
UploadHandler --> MaterialGRPCHandler : UploadImage(bytes)
MaterialRepository --> MaterialDB : SQL
MaterialGRPCHandler --> MinIO : HTTP PUT
MaterialHTTPHandler ..> UploadHandler : nhận image_url từ UI

note bottom
  image_url/images đã có trong bootstrap và migration.
  Update/Delete Listing và Create Demand là stub.
end note
@enduml
