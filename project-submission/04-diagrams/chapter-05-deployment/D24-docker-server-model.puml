@startuml
title D24 - Mô hình triển khai hai server hiện tại
skinparam componentStyle rectangle

actor "Guest / Business User / Admin" as user

node "Frontend Server" as frontendServer {
  component "Nginx\nHTTP :13005" as nginx
  artifact "React SPA\nVite dist\n/tmp/stitch-app" as frontend
  nginx --> frontend : static + SPA fallback
}

node "Backend Docker Server" as backendServer {
  frame "Docker network: cme-network" {
    component "cme-api-gateway\nHTTP :8085" as gateway
    component "cme-auth-service\n:50051" as auth
    component "cme-company-service\n:50052" as company
    component "cme-material-service\n:50053" as material
    component "cme-order-service\n:50054" as order
    component "cme-review-service\n:50055" as review
    component "cme-notification-service\n:50056" as notif

    database "cme-postgres\nPostgreSQL 15\nHost :5433" as postgres {
      artifact "auth_db" as authdb
      artifact "company_db" as companydb
      artifact "material_db" as materialdb
      artifact "order_db" as orderdb
      artifact "review_db" as reviewdb
      artifact "notif_db" as notifdb
    }

    queue "cme-nats\nJetStream\n:4222 / :8222" as nats
    storage "cme-minio\n:9000 / :9001" as minio
  }

  folder "Persistent volumes" {
    artifact "pg-data" as pgvolume
    artifact "minio-data" as miniovolume
  }
}

user --> nginx : Browser
nginx --> gateway : reverse proxy /api/

gateway --> auth : gRPC
gateway --> company : gRPC
gateway --> material : gRPC
gateway --> order : gRPC
gateway --> review : gRPC
gateway --> notif : gRPC

auth --> authdb : SQL
company --> companydb : SQL
material --> materialdb : SQL
order --> orderdb : SQL
review --> reviewdb : SQL
notif --> notifdb : SQL
material --> minio : upload ảnh
order --> nats : publish cme.orders.*
nats --> notif : subscribe event
postgres --> pgvolume
minio --> miniovolume

note bottom of gateway
  API Gateway publish 8085 và ở cme-network.
  Gateway không truy cập PostgreSQL trực tiếp.
end note
@enduml
