@startuml
title D03 - Quy trình trao đổi vật liệu và giao dịch

|Seller|
start
:Upload ảnh vật liệu;
:Đăng nguồn cung;

|Hệ thống|
:Kiểm tra doanh nghiệp verified;
:Công bố nguồn cung active;

|Buyer|
:Tìm kiếm/lọc nguồn cung;
if (Tìm thấy vật liệu phù hợp?) then (Có)
  :Xem chi tiết;
  :Nhập số lượng, giá và lời nhắn;
  :Gửi Offer;
else (Không)
  :Xem sàn nhu cầu;
  note right
    Create Demand hiện là stub;
    chưa ghi database.
  end note
  stop
endif

|Hệ thống|
:Kiểm tra doanh nghiệp Buyer verified;
:Tạo Offer pending;
:Ghi escrow ledger holding;
:Tạo Notification cho Seller;

|Seller|
:Xem Offer nhận được;
if (Chấp nhận Offer?) then (Có)
  |Hệ thống|
  :Cập nhật Offer accepted;
  :Tạo Transaction confirmed;
  :Tạo TransactionEvent;
  :Gắn escrow với Transaction;
  :Thông báo cho Buyer;
else (Không)
  |Hệ thống|
  :Cập nhật Offer rejected;
  stop
endif

|Seller|
:Xác nhận đã giao hàng;
|Hệ thống|
:Transaction -> in_progress;
:Lưu TransactionEvent;

|Buyer|
:Xác nhận đã nhận hàng;
|Hệ thống|
:Transaction -> completed;
:Release escrow ledger;
:Ghi phí 2% và cộng Seller wallet;
:Thông báo hai bên;

|Buyer|
:Đánh giá Seller;
stop

legend bottom
  Escrow, phí và wallet chỉ là ledger prototype.
  Không có chuyển tiền hoặc logistics thật.
endlegend
@enduml

