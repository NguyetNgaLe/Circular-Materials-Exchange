@startuml
title D02 - Quy trình đăng ký và duyệt doanh nghiệp

|Business User|
start
:Đăng ký hoặc đăng nhập;
:Nhập hồ sơ doanh nghiệp;

|Hệ thống|
:Kiểm tra dữ liệu bắt buộc;
if (Dữ liệu hợp lệ?) then (Có)
  :Tạo Company trạng thái pending;
  :Gắn company_id với User;
else (Không)
  :Thông báo lỗi;
  |Business User|
  :Chỉnh sửa dữ liệu và gửi lại;
  stop
endif

|Admin|
:Xem danh sách doanh nghiệp;
:Kiểm tra hồ sơ;
if (Chấp thuận?) then (Có)
  |Hệ thống|
  :Cập nhật trạng thái verified;
  |Business User|
  :Được đăng nguồn cung và gửi Offer;
else (Không)
  |Admin|
  :Nhập lý do từ chối;
  |Hệ thống|
  :Cập nhật trạng thái rejected;
  |Business User|
  :Xem lý do từ chối;
  note right
    Code hiện chưa expose API
    cập nhật lại Company.
  end note
endif
stop
@enduml

