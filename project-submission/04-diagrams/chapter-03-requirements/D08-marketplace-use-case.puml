@startuml
left to right direction
title D08 - Use Case Marketplace cung và cầu

actor Guest
actor "Business User" as Business
actor Buyer
actor Seller
Buyer -|> Business
Seller -|> Business

rectangle "Marketplace" {
  usecase "UC008 - Xem danh mục" as Categories
  usecase "UC009 - Xem / tìm kiếm /\nlọc nguồn cung" as ListSupply
  usecase "UC010 - Xem chi tiết\nnguồn cung" as SupplyDetail
  usecase "UC011 - Upload ảnh" as Upload
  usecase "UC012 - Đăng nguồn cung" as CreateSupply
  usecase "UC013 - Cập nhật /\nẩn-hiện nguồn cung" as UpdateSupply
  usecase "UC014 - Xóa nguồn cung" as DeleteSupply
  usecase "UC015 - Xem nhu cầu" as ListDemand
  usecase "UC016 - Đăng nhu cầu\n<<stub>>" as CreateDemand
  usecase "Kiểm tra Company verified" as VerifyCompany
}

Guest --> Categories
Guest --> ListSupply
Guest --> SupplyDetail
Guest --> ListDemand
Seller --> Upload
Seller --> CreateSupply
Seller --> UpdateSupply
Seller --> DeleteSupply
Buyer --> CreateDemand
CreateSupply .> Upload : <<include>>
CreateSupply .> VerifyCompany : <<include>>

note bottom
  Update/Hide Listing kiểm tra Owner/Admin và cập nhật database;
  Delete Listing kiểm tra Owner/Admin và xóa database;
  Create Demand chưa INSERT database.
end note
@enduml
