@startuml
left to right direction
title D07 - Use Case tài khoản và doanh nghiệp

actor Guest
actor "Business User" as User
actor Admin

rectangle "Tài khoản và doanh nghiệp" {
  usecase "UC001 - Đăng ký" as Register
  usecase "UC002 - Đăng nhập\n(demo bearer token)" as Login
  usecase "UC003 - Xem thông tin\nngười dùng hiện tại" as ViewProfile
  usecase "UC004 - Tạo hồ sơ\ndoanh nghiệp" as CreateCompany
  usecase "UC005 - Xem hồ sơ /\ntrạng thái doanh nghiệp" as ViewCompany
  usecase "UC006 - Duyệt\ndoanh nghiệp" as Approve
  usecase "UC007 - Từ chối\ndoanh nghiệp" as Reject
  usecase "Nhập lý do từ chối" as Reason
}

Guest --> Register
Guest --> Login
User --> ViewProfile
User --> CreateCompany
User --> ViewCompany
Admin --> Approve
Admin --> Reject
Reject .> Reason : <<include>>

note bottom
  Cập nhật User/Company có trong proto/service
  nhưng chưa được expose qua REST.
end note
@enduml

