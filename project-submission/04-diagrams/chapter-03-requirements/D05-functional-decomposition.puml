@startuml
title D05 - Phân rã chức năng hệ thống
skinparam packageStyle rectangle

package "Circular Materials Exchange" {
  package "1. Tài khoản và phân quyền" {
    [Đăng ký / đăng nhập]
    [Xem thông tin hiện tại]
    [Bảo vệ route / kiểm tra Admin]
  }

  package "2. Doanh nghiệp" {
    [Tạo / xem doanh nghiệp]
    [Duyệt / từ chối doanh nghiệp]
  }

  package "3. Marketplace và media" {
    [Xem danh mục]
    [Xem / đăng nguồn cung]
    [Upload ảnh MinIO]
    [Xem / đăng nhu cầu]
    [Tìm kiếm và lọc]
  }

  package "4. Offer và giao dịch" {
    [Gửi / xử lý Offer]
    [Tạo Transaction]
    [Xác nhận giao hàng / nhận hàng]
    [Lưu timeline]
  }

  package "5. Tài chính prototype" {
    [Escrow ledger]
    [Platform fee / wallet]
    [Seller wallet]
    [Withdrawal request]
  }

  package "6. Uy tín và thông báo" {
    [Review đối tác]
    [Notification / unread count]
  }

  package "7. Quản trị" {
    [Duyệt doanh nghiệp]
    [Finance overview]
    [Quản lý escrow / withdrawal]
    [Dashboard / báo cáo UI]
  }
}

note bottom
  Matching tự động, payment ngân hàng và logistics
  không thuộc chức năng đã triển khai.
end note
@enduml

