Seller -|> Business

rectangle "Circular Materials Exchange" {
  usecase "Xem và tìm kiếm\nmarketplace / nhu cầu" as UC1
  usecase "Đăng ký / đăng nhập" as UC2
  usecase "Tạo / xem hồ sơ\ndoanh nghiệp" as UC3
  usecase "Upload ảnh và\nđăng nguồn cung" as UC4
  usecase "Đăng nhu cầu\n<<partial>>" as UC5
  usecase "Gửi / xử lý Offer" as UC6
  usecase "Theo dõi và\nhoàn tất giao dịch" as UC7
  usecase "Xem Seller wallet" as UC8
  usecase "Đánh giá đối tác" as UC9
  usecase "Xem thông báo" as UC10
  usecase "Duyệt doanh nghiệp" as UC11
  usecase "Quản trị finance /\nescrow prototype" as UC12
}

Guest --> UC1
Guest --> UC2
Business --> UC3
Seller --> UC4
Buyer --> UC5
Buyer --> UC6
Seller --> UC6
Buyer --> UC7
Seller --> UC7
Seller --> UC8
Buyer --> UC9
Seller --> UC9
Business --> UC10
Admin --> UC11
Admin --> UC12

